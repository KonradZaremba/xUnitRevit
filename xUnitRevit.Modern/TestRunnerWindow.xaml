<Window x:Class="xUnitRevit.TestRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xUnit Revit by Speckle"
        Width="800" Height="600"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Assembly loading -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Load Assembly" Click="LoadAssembly_Click" Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="Run All" Click="RunAll_Click" Padding="10,5" Margin="0,0,10,0"
                    IsEnabled="{Binding HasTests}"/>
            <Button Content="Run Selected" Click="RunSelected_Click" Padding="10,5"
                    IsEnabled="{Binding HasSelectedTests}"/>
        </StackPanel>

        <!-- Status bar -->
        <TextBlock Grid.Row="1" Margin="0,0,0,5">
            <Run Text="Tests: "/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
            <Run Text=" | Passed: "/><Run Text="{Binding PassedCount, Mode=OneWay}" Foreground="Green"/>
            <Run Text=" | Failed: "/><Run Text="{Binding FailedCount, Mode=OneWay}" Foreground="Red"/>
            <Run Text=" | Skipped: "/><Run Text="{Binding SkippedCount, Mode=OneWay}" Foreground="Orange"/>
        </TextBlock>

        <!-- Test list -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Tests}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="Test Name" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Progress -->
        <ProgressBar Grid.Row="3" Height="4" Margin="0,5,0,0"
                     IsIndeterminate="{Binding IsRunning}"/>

        <!-- Watch status -->
        <TextBlock Grid.Row="3" Margin="0,12,5,0" HorizontalAlignment="Right"
                   FontSize="10" Foreground="Gray"
                   Text="{Binding WatchStatus}"/>
    </Grid>
</Window>
